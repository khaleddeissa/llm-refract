{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refract text artifact header",
  "type": "object",
  "required": ["format", "encoding", "sha256"],
  "properties": {
    "format": {
      "const": "refract.artifact.v1"
    },
    "encoding": {
      "const": "json"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
